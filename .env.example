# Deployment
# Private key for the deployer account (mainnet/testnet), with prefix 0x
# This account will own the deployed contracts
PRIVATE_KEY_DEPLOYER=0xPRIVATE_KEY_DEPLOYER

# Testing
# Private key for test user account (for simulating user positions), with prefix 0x
PRIVATE_KEY_USER=0xPRIVATE_KEY_USER

# RPC URLs
# HTTP RPC endpoint for Sepolia testnet
SEPOLIA_RPC_URL=RPC_URL

# API Keys
# Etherscan API key for contract verification
ETHERSCAN_API_KEY=API_KEY
